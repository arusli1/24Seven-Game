# Everything here is optional: without it the site works, with no sign-in or leaderboard.

# Google sign-in (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Any long random string (e.g. `openssl rand -base64 32`)
NEXTAUTH_SECRET=
# The site's address (http://localhost:3000 for local dev)
NEXTAUTH_URL=https://hard24.vercel.app

# Leaderboard storage: Vercel → Storage → Upstash for Redis sets these automatically
KV_REST_API_URL=
KV_REST_API_TOKEN=
